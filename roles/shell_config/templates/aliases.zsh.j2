# ─────────────────────────────────────────────────────────────────────────────
# ~/.aliases.zsh — Generated by Ansible
# Target: {{ ansible_os_family | default('Unknown') }}
# ─────────────────────────────────────────────────────────────────────────────

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  NAVIGATION                                                                 ║
# ╚══════════════════════════════════════════════════════════════════════════════╝
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias ~='cd ~'
alias -- -='cd -'
alias bd='cd "$OLDPWD"'

# fzf-powered cd (si fzf disponible)
if command -v fzf &>/dev/null; then
  alias fcd='cd "$(find . -maxdepth 4 -type d 2>/dev/null | fzf --height 40% --reverse)"'
fi

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  LISTING (lsd > eza > ls)                                                  ║
# ╚══════════════════════════════════════════════════════════════════════════════╝
if command -v lsd &>/dev/null; then
  alias ls='lsd'
  alias l='lsd -l'
  alias la='lsd -la'
  alias lt='lsd --tree'
  alias lt2='lsd --tree --depth 2'
  alias lt3='lsd --tree --depth 3'
  alias lsize='lsd -lS --total-size'
  alias ltime='lsd -lt'
elif command -v eza &>/dev/null; then
  alias ls='eza --icons'
  alias l='eza -l --icons --git'
  alias la='eza -la --icons --git'
  alias lt='eza --tree --icons'
  alias lt2='eza --tree --icons --level=2'
  alias lt3='eza --tree --icons --level=3'
  alias lsize='eza -l --icons --sort=size'
  alias ltime='eza -l --icons --sort=modified'
else
{% if ansible_os_family | default('') == 'Darwin' %}
  alias ls='ls -G'
{% else %}
  alias ls='ls --color=auto'
{% endif %}
  alias l='ls -lh'
  alias la='ls -lah'
fi
alias ll='l'
alias lld='l -d */'

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  CAT → bat                                                                 ║
# ╚══════════════════════════════════════════════════════════════════════════════╝
if command -v batcat &>/dev/null; then
  alias cat='batcat --paging=never'
  alias bat='batcat'
  alias batp='batcat --paging=always'
  alias batd='batcat --diff'
elif command -v bat &>/dev/null; then
  alias cat='bat --paging=never'
  alias batp='bat --paging=always'
  alias batd='bat --diff'
fi

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  GREP → ripgrep                                                            ║
# ╚══════════════════════════════════════════════════════════════════════════════╝
if command -v rg &>/dev/null; then
  alias rg='rg --smart-case'
  alias rgi='rg --no-ignore'
  alias rgl='rg -l'
else
  alias grep='grep --color=auto'
  alias egrep='egrep --color=auto'
  alias fgrep='fgrep --color=auto'
fi

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  FIND → fd                                                                 ║
