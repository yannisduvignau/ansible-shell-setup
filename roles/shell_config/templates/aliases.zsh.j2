alias please='sudo'
alias sudoedit='sudo -e'
alias su='sudo -i'
alias chownme='sudo chown -R $(whoami):$(id -gn)'
alias 000='chmod 000'
alias 644='chmod 644'
alias 755='chmod 755'
alias 700='chmod 700'
