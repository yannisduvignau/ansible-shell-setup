  # ╔══════════════════════════════════════════════════════════════════════════╗
  # ║  NETWORK — VPN IP (custom segment)                                      ║
  # ╚══════════════════════════════════════════════════════════════════════════╝
  #
  # Detects active VPN tunnel interfaces:
  #   Linux  : tun*, wg*, tailscale*, nordlynx
  #   macOS  : utun*, ipsec*, ppp*, gif*
  #
  # Shows: 󰖂 10.8.0.2 (tun0)     — green when connected
  # Hidden when no VPN is active.

  function prompt_my_vpn_ip() {
    local vpn_ip="" vpn_iface=""

{% if ansible_os_family | default('') == 'Darwin' %}
    # ── macOS: check utun*, ipsec*, ppp*, tun*, gif*, wg* ──
    local -a ifaces
    ifaces=( ${(f)"$(
      /sbin/ifconfig -l 2>/dev/null | tr ' ' '\n' |
      grep -E '^(utun|ipsec|ppp|tun|gif|wg)[0-9]*$'
    )"} )

    local iface
    for iface in "${ifaces[@]}"; do
      vpn_ip="$( /sbin/ifconfig "$iface" 2>/dev/null |
                 awk '/inet / && !/127\.0\.0\.1/ { print $2; exit }' )"
      if [[ -n "$vpn_ip" ]]; then
        vpn_iface="$iface"
        break
      fi
    done

    # Tailscale (macOS) — uses its own CLI
    if [[ -z "$vpn_ip" ]] && command -v tailscale &>/dev/null; then
      vpn_ip="$( tailscale ip -4 2>/dev/null )"
      [[ -n "$vpn_ip" ]] && vpn_iface="tailscale"
    fi
{% else %}
    # ── Linux: check tun*, wg*, nordlynx, tailscale0, ppp* ──
    local -a ifaces
    ifaces=( ${(f)"$(
      /sbin/ip -o link show 2>/dev/null |
      awk -F': ' '/tun[0-9]|wg[0-9]|nordlynx|tailscale[0-9]|ppp[0-9]/ { print $2 }'
    )"} )

    local iface
    for iface in "${ifaces[@]}"; do
      vpn_ip="$( /sbin/ip -4 -o addr show "$iface" 2>/dev/null |
                 awk '{ split($4, a, "/"); print a[1]; exit }' )"
      if [[ -n "$vpn_ip" ]]; then
        vpn_iface="$iface"
        break
      fi
    done

    # Tailscale fallback (Linux)
    if [[ -z "$vpn_ip" ]] && command -v tailscale &>/dev/null; then
      vpn_ip="$( tailscale ip -4 2>/dev/null )"
      [[ -n "$vpn_ip" ]] && vpn_iface="tailscale"
    fi
{% endif %}

    # Only render if a VPN IP was found
    [[ -n "$vpn_ip" ]] || return

    p10k segment -f 78 -i '󰖂' -t "${vpn_ip} %F{240}(${vpn_iface})%f"
  }

