alias apts='apt search'
alias aptl='apt list --installed'
alias aptr='sudo apt remove'
alias aptc='sudo apt autoremove -y && sudo apt autoclean'
alias aptinfo='apt show'
{% endif %}

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  EDITOR                                                                    ║
# ╚══════════════════════════════════════════════════════════════════════════════╝
alias v='${EDITOR:-nano}'
alias sv='sudo ${EDITOR:-nano}'

# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  UTILITAIRES                                                               ║
# ╚══════════════════════════════════════════════════════════════════════════════╝
alias h='history | tail -50'
alias hg='history | grep'
alias mkdir='mkdir -pv'
alias cp='cp -iv'
alias mv='mv -iv'
alias rm='rm -iv'
alias rmf='rm -rf'
alias ln='ln -sv'
alias wget='wget -c'
alias curl='curl -L'
alias path='echo $PATH | tr ":" "\n" | nl'
alias now='date +"%Y-%m-%d %H:%M:%S"'
alias timestamp='date +%s'
alias week='date +%V'
alias weather='curl -s "wttr.in/?lang=fr&format=3"'
alias wttr='curl -s "wttr.in/?lang=fr"'
alias sha256='shasum -a 256'
alias urlencode='python3 -c "import sys,urllib.parse; print(urllib.parse.quote(sys.argv[1]))"'
alias urldecode='python3 -c "import sys,urllib.parse; print(urllib.parse.unquote(sys.argv[1]))"'
alias jwt='_jwt_decode'       # fonction dans functions.zsh
alias b64e='base64'
alias b64d='base64 -d'
alias json='python3 -m json.tool'
alias serve='python3 -m http.server 8000'
alias mypath='readlink -f'
alias extract='_extract'      # fonction dans functions.zsh

{% if ansible_os_family | default('') == 'Darwin' %}
# macOS-specific
alias showfiles='defaults write com.apple.finder AppleShowAllFiles -bool true && killall Finder'
alias hidefiles='defaults write com.apple.finder AppleShowAllFiles -bool false && killall Finder'
alias emptytrash='sudo rm -rfv /Volumes/*/.Trashes; sudo rm -rfv ~/.Trash; sudo rm -rfv /private/var/log/asl/*.asl'
alias cpwd='pwd | pbcopy && echo "✅ Path copied"'
alias afk='open -a ScreenSaverEngine'
{% else %}
alias cpwd='pwd | xclip -selection clipboard 2>/dev/null && echo "✅ Path copied" || pwd | xsel --clipboard 2>/dev/null && echo "✅ Path copied"'
alias open='xdg-open 2>/dev/null'
{% endif %}

